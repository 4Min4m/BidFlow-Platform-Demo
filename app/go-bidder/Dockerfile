# Build stage
FROM golang:1.22-alpine AS builder
WORKDIR /src
COPY go.mod ./
# go.sum is generated by `go mod tidy`
COPY go.sum* ./
RUN go mod download
COPY main.go ./
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/go-bidder .

# Runtime stage — distroless, non-root by default (compliant deployments)
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/go-bidder .
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/go-bidder"]
